# Copy to .env before starting the server. See AGENTS.md for startup notes.

# Required: MongoDB Atlas connection string (with credentials + db name in URI).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Required: database name passed to client.db() by src/config/db.js.
DB_NAME=shomajsetu

# HS256 fallback secret used by src/middleware/verifyJwt.js when JWKS verification fails.
JWT_SECRET=replace-with-a-long-random-secret

# Auth server exposing /api/auth/jwks (RS256/JWKS verification, tried first).
AUTH_SERVER_URL=http://localhost:3000

# Browser origin allowed by CORS. http://localhost:3000 is always allowed too.
CLIENT_URL=http://localhost:3000

# HTTP port for the API (defaults to 5000 when unset or invalid).
PORT=5000
